<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OcdWizard.ControlStation.ViewModels"
             xmlns:loc="using:OcdWizard.ControlStation.Localization"
             x:Class="OcdWizard.ControlStation.Views.ExperimentEditorView"
             x:DataType="vm:ExperimentEditorViewModel">
    <UserControl.Styles>
        <!-- Highlights the event currently being run (driven by the live engine state). -->
        <Style Selector="Border.eventRow">
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.eventRow.current">
            <Setter Property="BorderBrush" Value="#4CC2FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#10324A" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="{loc:T Editor_ExperimentNameWatermark}" />
                <Button Grid.Column="1" Classes="Subtle" Content="{loc:T Editor_ImportButton}"
                        Click="OnImportExperimentClick" Margin="6,0,0,0"
                        ToolTip.Tip="{loc:T Editor_ImportTooltip}" />
                <Button Grid.Column="2" Classes="Subtle" Content="{loc:T Editor_ExportButton}"
                        Click="OnExportExperimentClick" Margin="6,0,0,0"
                        ToolTip.Tip="{loc:T Editor_ExportTooltip}" />
                <Button Grid.Column="3" Classes="Subtle" Content="{loc:T Editor_PullButton}"
                        Command="{Binding PullCommand}" Margin="6,0,0,0"
                        ToolTip.Tip="{loc:T Editor_PullTooltip}" />
                <Button Grid.Column="4" Classes="Accent" Content="{loc:T Editor_PushButton}"
                        Command="{Binding SaveCommand}" Margin="6,0,0,0"
                        ToolTip.Tip="{loc:T Editor_PushTooltip}" />
            </Grid>
            <TextBox Text="{Binding Notes}"
                     Watermark="{loc:T Editor_NotesWatermark}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="48" MaxHeight="120"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4">
            <TextBlock Text="{loc:T Editor_TriggersSectionHeader}" Classes="SectionHeader" />
            <ItemsControl ItemsSource="{Binding Triggers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TriggerEditModel">
                        <Border BorderBrush="#333" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,2">
                            <Grid ColumnDefinitions="*,120,*,80,Auto" RowDefinitions="Auto,Auto">
                                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Watermark="{loc:T Common_NameWatermark}" Margin="0,0,4,0" />
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding KindLabel}"
                                          ItemsSource="{x:Static vm:TriggerEditModel.Kinds}"
                                          Margin="0,0,4,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{x:Static vm:WireValueDisplayConverter.Instance}"
                                                                  ConverterParameter="TriggerKind">
                                                        <Binding />
                                                        <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Id}" Watermark="{loc:T Common_IdWatermark}" Margin="0,0,4,0" />
                                <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding Enabled}" Content="{loc:T Editor_TriggerEnabledCheckBox}" />
                                <Button Grid.Row="0" Grid.Column="4" Content="✕"
                                        Command="{Binding $parent[ItemsControl].((vm:ExperimentEditorViewModel)DataContext).RemoveTriggerCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{loc:T Editor_RemoveTriggerTooltip}" />
                                <!-- Kind-specific parameter row -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                            Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <!-- RapidMovement: accel threshold -->
                                    <TextBlock Text="{loc:T Editor_TriggerThresholdLabel}" VerticalAlignment="Center" FontSize="11"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RapidMovement'}" />
                                    <NumericUpDown Value="{Binding AccelThreshold}" Minimum="0" Maximum="20"
                                                   Increment="0.1" FormatString="0.0" Width="90"
                                                   IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RapidMovement'}" />
                                    <TextBlock Text="{loc:T Editor_UnitG}" VerticalAlignment="Center" FontSize="11" Foreground="#888"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RapidMovement'}" />
                                    <!-- RepeatingMovement: minHz, maxHz, sustainSec -->
                                    <TextBlock Text="{loc:T Editor_TriggerHzLabel}" VerticalAlignment="Center" FontSize="11"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RepeatingMovement'}" />
                                    <NumericUpDown Value="{Binding MinHz}" Minimum="0" Maximum="20"
                                                   Increment="0.1" FormatString="0.0" Width="80"
                                                   IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RepeatingMovement'}" />
                                    <TextBlock Text="–" VerticalAlignment="Center"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RepeatingMovement'}" />
                                    <NumericUpDown Value="{Binding MaxHz}" Minimum="0" Maximum="20"
                                                   Increment="0.1" FormatString="0.0" Width="80"
                                                   IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RepeatingMovement'}" />
                                    <TextBlock Text="{loc:T Common_ForDuration}" VerticalAlignment="Center" FontSize="11"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RepeatingMovement'}" />
                                    <NumericUpDown Value="{Binding SustainSec}" Minimum="0" Maximum="60"
                                                   Increment="0.5" FormatString="0.0" Width="80"
                                                   IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RepeatingMovement'}" />
                                    <TextBlock Text="{loc:T Common_UnitSeconds}" VerticalAlignment="Center" FontSize="11" Foreground="#888"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RepeatingMovement'}" />
                                    <!-- HeartRate: bpm, above/below, sustainSec -->
                                    <NumericUpDown Value="{Binding Bpm}" Minimum="40" Maximum="220"
                                                   Increment="1" FormatString="0" Width="80"
                                                   IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='HeartRate'}" />
                                    <TextBlock Text="{loc:T Editor_UnitBpm}" VerticalAlignment="Center" FontSize="11"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='HeartRate'}" />
                                    <CheckBox Content="{loc:T Editor_TriggerAboveCheckBox}" IsChecked="{Binding Above}"
                                              IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='HeartRate'}" />
                                    <TextBlock Text="{loc:T Common_ForDuration}" VerticalAlignment="Center" FontSize="11"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='HeartRate'}" />
                                    <NumericUpDown Value="{Binding SustainSec}" Minimum="0" Maximum="60"
                                                   Increment="0.5" FormatString="0.0" Width="80"
                                                   IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='HeartRate'}" />
                                    <TextBlock Text="{loc:T Common_UnitSeconds}" VerticalAlignment="Center" FontSize="11" Foreground="#888"
                                               IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='HeartRate'}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="Subtle" Content="{loc:T Editor_AddTriggerButton}"
                    Command="{Binding AddTriggerCommand}" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="{loc:T Editor_EventsSectionHeader}" Classes="SectionHeader" />
                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ExperimentEventEditModel">
                            <Border Classes="eventRow" Classes.current="{Binding IsCurrent}"
                                    CornerRadius="4" Padding="6" Margin="0,2">
                              <Panel>
                                <!-- ColumnDefinitions: index, type, kind, duration label+field, id, reorder, remove, intervention toggle -->
                                <Grid ColumnDefinitions="22,*,110,Auto,110,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding IndexLabel}"
                                               VerticalAlignment="Center"
                                               Foreground="#888" FontSize="11"
                                               Margin="0,0,4,0" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Type}" Watermark="{loc:T Common_NameWatermark}" Margin="0,0,4,0" />
                                    <ComboBox Grid.Row="0" Grid.Column="2" SelectedItem="{Binding KindLabel}"
                                              ItemsSource="{x:Static vm:ExperimentEventEditModel.Kinds}"
                                              Margin="0,0,4,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{x:Static vm:WireValueDisplayConverter.Instance}"
                                                                      ConverterParameter="EventKind">
                                                            <Binding />
                                                            <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{loc:T Common_UnitSeconds}" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="11" Foreground="#888" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="4"
                                                   Value="{Binding Duration}"
                                                   Minimum="0" Maximum="3600"
                                                   FormatString="0"
                                                   Increment="1"
                                                   Margin="0,0,4,0" />
                                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding Id}" Watermark="{loc:T Common_IdWatermark}" Margin="0,0,4,0" />
                                    <Button Grid.Row="0" Grid.Column="6" Content="↑" Width="24" Padding="0"
                                            Command="{Binding $parent[ItemsControl].((vm:ExperimentEditorViewModel)DataContext).MoveEventUpCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,2,0"
                                            ToolTip.Tip="{loc:T Editor_MoveEventUpTooltip}" />
                                    <Button Grid.Row="0" Grid.Column="7" Content="↓" Width="24" Padding="0"
                                            Command="{Binding $parent[ItemsControl].((vm:ExperimentEditorViewModel)DataContext).MoveEventDownCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,2,0"
                                            ToolTip.Tip="{loc:T Editor_MoveEventDownTooltip}" />
                                    <Button Grid.Row="0" Grid.Column="8" Content="✕"
                                            Command="{Binding $parent[ItemsControl].((vm:ExperimentEditorViewModel)DataContext).RemoveEventCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{loc:T Editor_RemoveEventTooltip}" />
                                    <CheckBox Grid.Row="0" Grid.Column="9" Content="🔔" ToolTip.Tip="{loc:T Editor_HasInterventionTooltip}"
                                              IsChecked="{Binding HasIntervention}" Margin="6,0,0,0" />

                                    <!-- Row 1: kind-specific timing params -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="10" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                        <NumericUpDown Value="{Binding RandomMin}" Minimum="0" Maximum="3600"
                                                       FormatString="0" Increment="1" Width="90"
                                                       IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RandomWait'}" />
                                        <TextBlock Text="–" VerticalAlignment="Center"
                                                   IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RandomWait'}" />
                                        <NumericUpDown Value="{Binding RandomMax}" Minimum="0" Maximum="3600"
                                                       FormatString="0" Increment="1" Width="90"
                                                       IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RandomWait'}" />
                                        <TextBox Text="{Binding WaitForActionId}" Watermark="{loc:T Editor_WaitForActionIdWatermark}" Width="160"
                                                 IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='WaitForAction'}" />
                                        <TextBox Text="{Binding WaitForTriggerId}" Watermark="{loc:T Editor_WaitForTriggerIdWatermark}" Width="160"
                                                 IsVisible="{Binding KindLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='WaitForTrigger'}" />
                                    </StackPanel>

                                    <!-- Row 2: intervention / distraction config (visible when HasIntervention) -->
                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="10"
                                            IsVisible="{Binding HasIntervention}"
                                            Background="#0D1020" CornerRadius="3" Padding="6,4" Margin="0,4,0,0">
                                        <StackPanel Spacing="6">
                                            <!-- Row A: display type + notification + duration -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                <TextBlock Text="{loc:T Editor_InterventionDisplayAsLabel}" VerticalAlignment="Center" FontSize="11" Foreground="#AABBDD" />
                                                <ComboBox SelectedItem="{Binding InterventionTypeLabel}" MinWidth="90" FontSize="11"
                                                          ItemsSource="{x:Static vm:ExperimentEventEditModel.InterventionTypeOptions}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static vm:WireValueDisplayConverter.Instance}"
                                                                                  ConverterParameter="InterventionType">
                                                                        <Binding />
                                                                        <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="{loc:T Editor_InterventionNotifyLabel}" VerticalAlignment="Center" FontSize="11" Foreground="#AABBDD" Margin="8,0,0,0" />
                                                <ComboBox SelectedItem="{Binding NotificationLabel}" MinWidth="160" FontSize="11"
                                                          ItemsSource="{x:Static vm:ExperimentEventEditModel.NotificationOptions}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static vm:WireValueDisplayConverter.Instance}"
                                                                                  ConverterParameter="Notification">
                                                                        <Binding />
                                                                        <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="{loc:T Common_ForDuration}" VerticalAlignment="Center" FontSize="11" Foreground="#888" />
                                                <NumericUpDown Value="{Binding InterventionDurationSecs}" Minimum="1" Maximum="3600"
                                                               Increment="1" FormatString="0" MinWidth="100" MaxWidth="120" FontSize="11" />
                                                <TextBlock Text="{loc:T Common_UnitSeconds}" VerticalAlignment="Center" FontSize="11" Foreground="#888" />
                                            </StackPanel>
                                            <!-- Row B: message -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{loc:T Editor_InterventionMessageLabel}" VerticalAlignment="Center" FontSize="11" Foreground="#AABBDD" />
                                                <TextBox Text="{Binding InterventionMessage}" Watermark="{loc:T Editor_InterventionMessageWatermark}"
                                                         MinWidth="260" FontSize="11" />
                                            </StackPanel>
                                            <!-- Row C: microgame OR phone task (mutually exclusive) -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{loc:T Editor_MicrogameLabel}" VerticalAlignment="Center" FontSize="11" Foreground="#AABBDD" />
                                                <ComboBox SelectedItem="{Binding GameTypeLabel}" MinWidth="140" FontSize="11"
                                                          ItemsSource="{x:Static vm:ExperimentEventEditModel.GameTypeOptions}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static vm:WireValueDisplayConverter.Instance}"
                                                                                  ConverterParameter="GameType">
                                                                        <Binding />
                                                                        <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="{loc:T Editor_OrSeparator}" VerticalAlignment="Center" FontSize="11" Foreground="#445" Margin="8,0" />
                                                <TextBlock Text="{loc:T Editor_PhoneTaskLabel}" VerticalAlignment="Center" FontSize="11" Foreground="#AABBDD" />
                                                <ComboBox SelectedItem="{Binding PhoneTaskLabel}" MinWidth="100" FontSize="11"
                                                          ItemsSource="{x:Static vm:ExperimentEventEditModel.PhoneTaskOptions}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static vm:WireValueDisplayConverter.Instance}"
                                                                                  ConverterParameter="PhoneTask">
                                                                        <Binding />
                                                                        <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="{loc:T Editor_MicrogamePhoneTaskHint}" VerticalAlignment="Center"
                                                           FontSize="10" Foreground="#556" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- Live countdown overlay for the running task (click-through). -->
                                <Border IsVisible="{Binding IsCurrent}" IsHitTestVisible="False"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#CC0A2A40" BorderBrush="#4CC2FF" BorderThickness="1"
                                        CornerRadius="6" Padding="8,1" Margin="0,0,2,0">
                                    <TextBlock Text="{Binding RemainingDisplay}" FontSize="18"
                                               FontWeight="Bold" Foreground="#9CD8FF" />
                                </Border>
                              </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="Subtle" Content="{loc:T Editor_AddEventButton}"
                        Command="{Binding AddEventCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
