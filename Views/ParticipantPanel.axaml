<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OcdWizard.ControlStation.ViewModels"
             xmlns:views="using:OcdWizard.ControlStation.Views"
             xmlns:ctrl="using:OcdWizard.ControlStation.Controls"
             xmlns:loc="using:OcdWizard.ControlStation.Localization"
             x:Class="OcdWizard.ControlStation.Views.ParticipantPanel"
             x:DataType="vm:ParticipantViewModel">

    <Border Classes="Card" Margin="3">
        <DockPanel>

            <!-- ── Coloured header strip ──────────────────────────────── -->
            <Border DockPanel.Dock="Top" CornerRadius="9,9,0,0" Padding="14,10">
                <Border.Background>
                    <SolidColorBrush Color="{Binding IsConnected,
                        Converter={StaticResource BoolToBrushConverter}}" />
                </Border.Background>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding IsConnected,
                                     Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Bold"
                                   Foreground="White" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}"
                               Foreground="#CCDDFF" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Grid.Column="2"
                               Foreground="#AABBDD" FontSize="10"
                               VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static vm:LocalizedFormatConverter.Instance}"
                                          ConverterParameter="Participant_ParticipantIdBadge">
                                <Binding Path="ParticipantKey" />
                                <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- ── Scrollable body ────────────────────────────────────── -->
            <ScrollViewer>
                <StackPanel Spacing="4" Margin="10,8">

                    <!-- CONNECTION CARD -->
                    <Border Name="TutConnection" Background="#1C1F30" CornerRadius="8" Padding="12,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:T Participant_ConnectionSectionHeader}" Classes="SectionHeader" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding IpAddress}"
                                         Watermark="{loc:T Participant_DeviceIpWatermark}"
                                         Margin="0,0,6,0" />
                                <Button Name="TutScan" Grid.Column="1" Classes="Subtle"
                                        Content="{loc:T Participant_ScanButton}"
                                        Command="{Binding ScanCommand}"
                                        IsEnabled="{Binding !IsScanning}"
                                        Margin="0,0,6,0" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding DiscoveredDevices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          PlaceholderText="{loc:T Participant_DeviceComboPlaceholder}"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,6,0" />
                                <Button Grid.Column="1" Classes="Accent"
                                        Content="{loc:T Participant_ConnectButton}"
                                        Command="{Binding ConnectCommand}"
                                        Margin="0,0,6,0" />
                                <Button Grid.Column="2" Classes="Subtle"
                                        Content="{loc:T Participant_DisconnectButton}"
                                        Command="{Binding DisconnectCommand}" />
                            </Grid>
                            <!-- Full sensor rate for a few minutes without a run, for checking fit
                                 and signal during setup. The watch idles again on its own. -->
                            <Button Classes="Subtle" HorizontalAlignment="Stretch"
                                    Content="{loc:T Participant_WakeWatchButton}"
                                    ToolTip.Tip="{loc:T Participant_WakeWatchTooltip}"
                                    Command="{Binding WakeWatchCommand}"
                                    IsEnabled="{Binding IsConnected}" />
                            <!-- Participant name / ID editable here or on the phone; kept in sync. -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{loc:T Participant_ParticipantFieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           FontSize="12" Foreground="#8899BB" />
                                <TextBox Grid.Column="1" Text="{Binding ParticipantKey}"
                                         Watermark="{loc:T Participant_ParticipantKeyWatermark}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- MOTION VISUALISER -->
                    <ctrl:CollapsiblePanel Name="TutMotion" Title="{loc:T Participant_MotionTrackerSectionTitle}">
                        <ctrl:CollapsiblePanel.Body>
                            <views:MotionView DataContext="{Binding}" />
                        </ctrl:CollapsiblePanel.Body>
                    </ctrl:CollapsiblePanel>

                    <!-- LIVE SENSORS -->
                    <ctrl:CollapsiblePanel Name="TutSensors" Title="{loc:T Participant_LiveSensorsSectionTitle}">
                        <ctrl:CollapsiblePanel.Body>
                            <StackPanel Spacing="5" Margin="10,6">
                                <!-- Heart rate -->
                                <Grid ColumnDefinitions="100,*,50">
                                    <TextBlock Grid.Column="0" Text="{loc:T Participant_HeartRateLabel}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="200"
                                                 Value="{Binding CurrentBpm}"
                                                 Height="10" CornerRadius="5"
                                                 Foreground="#E84393" Margin="6,0" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center" FontSize="11">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static vm:LocalizedFormatConverter.Instance}"
                                                          ConverterParameter="Participant_BpmValueFormat">
                                                <Binding Path="CurrentBpm" />
                                                <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                                <!-- Accelerometer delta -->
                                <Grid ColumnDefinitions="100,*,55">
                                    <TextBlock Grid.Column="0" Text="{loc:T Participant_AccelXLabel}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="5"
                                                 Value="{Binding AccelX, Converter={StaticResource AbsValueConverter}}"
                                                 Height="10" CornerRadius="5"
                                                 Foreground="#F4A261" Margin="6,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AccelX, StringFormat={}{0:F2}}"
                                               VerticalAlignment="Center" FontSize="11" />
                                </Grid>
                                <Grid ColumnDefinitions="100,*,55">
                                    <TextBlock Grid.Column="0" Text="{loc:T Participant_AccelYLabel}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="5"
                                                 Value="{Binding AccelY, Converter={StaticResource AbsValueConverter}}"
                                                 Height="10" CornerRadius="5"
                                                 Foreground="#A8DADC" Margin="6,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AccelY, StringFormat={}{0:F2}}"
                                               VerticalAlignment="Center" FontSize="11" />
                                </Grid>
                                <Grid ColumnDefinitions="100,*,55">
                                    <TextBlock Grid.Column="0" Text="{loc:T Participant_AccelZLabel}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="5"
                                                 Value="{Binding AccelZ, Converter={StaticResource AbsValueConverter}}"
                                                 Height="10" CornerRadius="5"
                                                 Foreground="#81B29A" Margin="6,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AccelZ, StringFormat={}{0:F2}}"
                                               VerticalAlignment="Center" FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </ctrl:CollapsiblePanel.Body>
                    </ctrl:CollapsiblePanel>

                    <!-- EXPERIMENT RUNNER -->
                    <ctrl:CollapsiblePanel Name="TutRunner" Title="{loc:T Participant_ExperimentRunnerSectionTitle}">
                        <ctrl:CollapsiblePanel.Body>
                            <views:ExperimentRunnerView DataContext="{Binding}" />
                        </ctrl:CollapsiblePanel.Body>
                    </ctrl:CollapsiblePanel>

                    <!-- EXPERIMENT EDITOR -->
                    <ctrl:CollapsiblePanel Title="{loc:T Participant_ExperimentEditorSectionTitle}">
                        <ctrl:CollapsiblePanel.Body>
                            <views:ExperimentEditorView DataContext="{Binding ExperimentEditor}" />
                        </ctrl:CollapsiblePanel.Body>
                    </ctrl:CollapsiblePanel>

                    <!-- SEND INTERVENTION -->
                    <ctrl:CollapsiblePanel Name="TutIntervention" Title="{loc:T Participant_SendInterventionSectionTitle}">
                        <ctrl:CollapsiblePanel.Body>
                            <StackPanel Spacing="10" Margin="10,8">

                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:T Participant_GameTypeLabel}" FontSize="11" Foreground="#8899BB" />
                                        <ComboBox SelectedItem="{Binding SelectedGameType}"
                                                  ItemsSource="{Binding GameTypes}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static vm:WireValueDisplayConverter.Instance}"
                                                                          ConverterParameter="GameType">
                                                                <Binding />
                                                                <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{loc:T Participant_NotificationLabel}" FontSize="11" Foreground="#8899BB" />
                                        <ComboBox SelectedItem="{Binding SelectedNotificationType}"
                                                  ItemsSource="{Binding NotificationTypes}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static vm:WireValueDisplayConverter.Instance}"
                                                                          ConverterParameter="Notification">
                                                                <Binding />
                                                                <Binding Source="{x:Static loc:Loc.Instance}" Path="LanguageTag" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Trivia sub-panel -->
                                <Border IsVisible="{Binding IsTrivia}"
                                        Background="#1C1F30" BorderBrush="#333355"
                                        BorderThickness="1" CornerRadius="7" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:T Participant_TriviaQuestionHeader}"
                                                   FontWeight="SemiBold" FontSize="12" />
                                        <TextBox Text="{Binding TriviaQuestionText}"
                                                 Watermark="{loc:T Participant_TriviaQuestionWatermark}" />
                                        <Grid ColumnDefinitions="20,*">
                                            <TextBlock Grid.Column="0" Text="{loc:T Common_AnswerLetterA}" VerticalAlignment="Center" FontSize="11" />
                                            <TextBox Grid.Column="1" Text="{Binding TriviaAnswerA}" Watermark="{loc:T Common_AnswerAWatermark}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="20,*">
                                            <TextBlock Grid.Column="0" Text="{loc:T Common_AnswerLetterB}" VerticalAlignment="Center" FontSize="11" />
                                            <TextBox Grid.Column="1" Text="{Binding TriviaAnswerB}" Watermark="{loc:T Common_AnswerBWatermark}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="20,*">
                                            <TextBlock Grid.Column="0" Text="{loc:T Common_AnswerLetterC}" VerticalAlignment="Center" FontSize="11" />
                                            <TextBox Grid.Column="1" Text="{Binding TriviaAnswerC}" Watermark="{loc:T Common_AnswerCWatermark}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="20,*">
                                            <TextBlock Grid.Column="0" Text="{loc:T Common_AnswerLetterD}" VerticalAlignment="Center" FontSize="11" />
                                            <TextBox Grid.Column="1" Text="{Binding TriviaAnswerD}" Watermark="{loc:T Common_AnswerDWatermark}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="{loc:T Participant_TriviaCorrectAnswerLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                            <ComboBox Grid.Column="1"
                                                      SelectedItem="{Binding TriviaCorrectAnswer}">
                                                <ComboBoxItem Content="{loc:T Common_AnswerLetterA}" />
                                                <ComboBoxItem Content="{loc:T Common_AnswerLetterB}" />
                                                <ComboBoxItem Content="{loc:T Common_AnswerLetterC}" />
                                                <ComboBoxItem Content="{loc:T Common_AnswerLetterD}" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="*,8,Auto">
                                    <Button Grid.Column="0" Classes="Danger"
                                            Content="{loc:T Participant_TriggerInterventionButton}"
                                            Command="{Binding TriggerCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2" Classes="Subtle"
                                            Content="{loc:T Common_CancelIcon}"
                                            Command="{Binding StopCommand}" />
                                </Grid>
                            </StackPanel>
                        </ctrl:CollapsiblePanel.Body>
                    </ctrl:CollapsiblePanel>

                    <!-- SYNCED LOGS -->
                    <ctrl:CollapsiblePanel Title="{loc:T Participant_SyncedLogsSectionTitle}">
                        <ctrl:CollapsiblePanel.Body>
                            <views:LogPanelView DataContext="{Binding}" />
                        </ctrl:CollapsiblePanel.Body>
                    </ctrl:CollapsiblePanel>

                    <!-- EVENT LOG -->
                    <ctrl:CollapsiblePanel Title="{loc:T Participant_EventLogSectionTitle}">
                        <ctrl:CollapsiblePanel.Body>
                            <ListBox ItemsSource="{Binding EventLog}"
                                     MaxHeight="160"
                                     Background="#0F1117"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Margin="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   FontFamily="Consolas, Courier New"
                                                   Foreground="#8899BB" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ctrl:CollapsiblePanel.Body>
                    </ctrl:CollapsiblePanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
