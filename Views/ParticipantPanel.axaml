<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OcdWizard.ControlStation.ViewModels"
             x:Class="OcdWizard.ControlStation.Views.ParticipantPanel"
             x:DataType="vm:ParticipantViewModel">

    <Border BorderBrush="#444" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
        <StackPanel Spacing="8">

            <!-- Header with status indicator -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,6,0"
                         Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="18" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus}" FontSize="11"
                           Foreground="#888" VerticalAlignment="Center" />
            </Grid>

            <!-- IP + Connect + Scan -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding IpAddress}" Watermark="Device IP (e.g. 192.168.1.42)"
                         Margin="0,0,4,0" />
                <Button Grid.Column="1" Content="Scan"
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding !IsScanning}"
                        Margin="0,0,4,0" />
                <Button Grid.Column="2" Content="Connect" Command="{Binding ConnectCommand}"
                        Margin="0,0,4,0" />
                <Button Grid.Column="3" Content="Disconnect" Command="{Binding DisconnectCommand}" />
            </Grid>

            <!-- Discovered devices dropdown (filled after scan) -->
            <ComboBox ItemsSource="{Binding DiscoveredDevices}"
                      SelectedItem="{Binding SelectedDevice}"
                      PlaceholderText="Scan to discover devices…"
                      HorizontalAlignment="Stretch" />

            <!-- Heart Rate -->
            <Grid ColumnDefinitions="80,*,40">
                <TextBlock Grid.Column="0" Text="Heart Rate:" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="200"
                             Value="{Binding CurrentBpm}" Margin="4,0" />
                <TextBlock Grid.Column="2" Text="{Binding CurrentBpm, StringFormat={}{0:F0}}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- Accelerometer X / Y / Z -->
            <Grid ColumnDefinitions="80,*,55">
                <TextBlock Grid.Column="0" Text="ΔX:" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="5"
                             Value="{Binding AccelX, Converter={StaticResource AbsValueConverter}}"
                             Margin="4,0" Foreground="#F4A261" />
                <TextBlock Grid.Column="2" Text="{Binding AccelX, StringFormat={}{0:F2}}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="80,*,55">
                <TextBlock Grid.Column="0" Text="ΔY:" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="5"
                             Value="{Binding AccelY, Converter={StaticResource AbsValueConverter}}"
                             Margin="4,0" Foreground="#A8DADC" />
                <TextBlock Grid.Column="2" Text="{Binding AccelY, StringFormat={}{0:F2}}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="80,*,55">
                <TextBlock Grid.Column="0" Text="ΔZ:" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="5"
                             Value="{Binding AccelZ, Converter={StaticResource AbsValueConverter}}"
                             Margin="4,0" Foreground="#81B29A" />
                <TextBlock Grid.Column="2" Text="{Binding AccelZ, StringFormat={}{0:F2}}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- Game Type / Notification Type -->
            <Grid ColumnDefinitions="*,*">
                <ComboBox Grid.Column="0" SelectedItem="{Binding SelectedGameType}"
                          ItemsSource="{Binding GameTypes}"
                          Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedNotificationType}"
                          ItemsSource="{Binding NotificationTypes}" />
            </Grid>

            <!-- Trivia editor (visible only when TRIVIA is selected) -->
            <Border IsVisible="{Binding IsTrivia}" BorderBrush="#555" BorderThickness="1"
                    CornerRadius="4" Padding="6">
                <StackPanel Spacing="4">
                    <TextBlock Text="Trivia Question" FontWeight="SemiBold" FontSize="11" />
                    <TextBox Text="{Binding TriviaQuestionText}" Watermark="Question…" />
                    <Grid ColumnDefinitions="16,*">
                        <TextBlock Grid.Column="0" Text="A" VerticalAlignment="Center" FontSize="11" />
                        <TextBox Grid.Column="1" Text="{Binding TriviaAnswerA}" Watermark="Answer A" />
                    </Grid>
                    <Grid ColumnDefinitions="16,*">
                        <TextBlock Grid.Column="0" Text="B" VerticalAlignment="Center" FontSize="11" />
                        <TextBox Grid.Column="1" Text="{Binding TriviaAnswerB}" Watermark="Answer B" />
                    </Grid>
                    <Grid ColumnDefinitions="16,*">
                        <TextBlock Grid.Column="0" Text="C" VerticalAlignment="Center" FontSize="11" />
                        <TextBox Grid.Column="1" Text="{Binding TriviaAnswerC}" Watermark="Answer C" />
                    </Grid>
                    <Grid ColumnDefinitions="16,*">
                        <TextBlock Grid.Column="0" Text="D" VerticalAlignment="Center" FontSize="11" />
                        <TextBox Grid.Column="1" Text="{Binding TriviaAnswerD}" Watermark="Answer D" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="Correct:" VerticalAlignment="Center"
                                   Margin="0,0,6,0" FontSize="11" />
                        <ComboBox Grid.Column="1" SelectedItem="{Binding TriviaCorrectAnswer}">
                            <ComboBoxItem Content="A" />
                            <ComboBoxItem Content="B" />
                            <ComboBoxItem Content="C" />
                            <ComboBoxItem Content="D" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Content="TRIGGER OCD DISTRACTION"
                        Command="{Binding TriggerCommand}"
                        Background="#C0392B" Foreground="White"
                        FontWeight="Bold" HorizontalAlignment="Stretch"
                        Margin="0,0,4,0" />
                <Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" />
            </Grid>

            <!-- Event log -->
            <TextBlock Text="Event Log" FontWeight="SemiBold" Margin="0,4,0,2" />
            <ListBox ItemsSource="{Binding EventLog}"
                     MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas, Courier New" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
    </Border>
</UserControl>
