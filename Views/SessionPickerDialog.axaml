<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OcdWizard.ControlStation.ViewModels"
        xmlns:loc="using:OcdWizard.ControlStation.Localization"
        x:Class="OcdWizard.ControlStation.Views.SessionPickerDialog"
        x:DataType="vm:SessionPickerViewModel"
        Title="{loc:T SessionPicker_DialogTitle}"
        Width="740" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="12">

        <Grid Grid.Row="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{loc:T SessionPicker_Description}"
                       TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#aaa" FontSize="12" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Sessions}"
                     SelectedItem="{Binding SelectedSession}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionSummaryRow">
                        <Grid ColumnDefinitions="130,160,160,*,60" Margin="2,4">
                            <TextBlock Grid.Column="0" Text="{Binding StartDisplay}"
                                       FontFamily="Consolas,Courier New,monospace" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Summary.Name}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Summary.Participants}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="#aaa" FontSize="11" Margin="8,0" />
                            <TextBlock Grid.Column="3" Text="{Binding Summary.Experiments}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="#aaa" FontSize="11" Margin="8,0" />
                            <TextBlock Grid.Column="4" Text="{Binding Summary.WatchDataCount}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Foreground="#666" FontSize="11"
                                       ToolTip.Tip="{loc:T SessionPicker_SnapshotCountTooltip}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock Text="{loc:T SessionPicker_SamplesLabel}" VerticalAlignment="Center" Foreground="#555" FontSize="11"
                       IsVisible="{Binding SelectedSession, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Content="{loc:T SessionPicker_ExportButton}" Command="{Binding ConfirmCommand}"
                    Background="#27AE60" Foreground="White" />
            <Button Content="{loc:T Common_Cancel}" Command="{Binding CancelCommand}" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
