<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:OcdWizard.ControlStation.Localization"
        x:Class="OcdWizard.ControlStation.Views.SaveTargetDialog"
        Title="{loc:T SaveTarget_DialogTitle}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="18" Spacing="14">
        <TextBlock Text="{loc:T SaveTarget_Heading}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#AAB" FontSize="12"
                   Text="{loc:T SaveTarget_DefaultMessage}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:T SaveTarget_OverwriteButton}" Classes="Primary" Click="OnOverwriteClick" />
            <Button Content="{loc:T SaveTarget_SaveAsButton}" Classes="Accent" Click="OnSaveAsClick" />
            <Button Content="{loc:T Common_Cancel}" Classes="Subtle" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
