<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OcdWizard.ControlStation.Views.SaveTargetDialog"
        Title="Save annotations"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="18" Spacing="14">
        <TextBlock Text="Save notes &amp; markers" FontSize="15" FontWeight="SemiBold" Foreground="White" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#AAB" FontSize="12"
                   Text="Where should the edited notes and markers be written?" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Overwrite loaded file" Classes="Primary" Click="OnOverwriteClick" />
            <Button Content="Save as new copy…" Classes="Accent" Click="OnSaveAsClick" />
            <Button Content="Cancel" Classes="Subtle" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
