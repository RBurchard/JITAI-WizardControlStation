<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:OcdWizard.ControlStation.Localization"
        x:Class="OcdWizard.ControlStation.Views.SessionSaveNameDialog"
        Title="{loc:T Session_SaveDialogTitle}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="{loc:T Session_SaveDialogLabel}" Foreground="#8899BB" FontSize="12"
                   TextWrapping="Wrap" />
        <TextBox x:Name="NameBox" Watermark="{loc:T TopBar_SessionNameWatermark}"
                 KeyDown="OnNameKeyDown" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="{loc:T Session_SaveButton}" Classes="Primary" Click="OnOkClick" />
            <Button Content="{loc:T Common_Cancel}" Classes="Subtle" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
