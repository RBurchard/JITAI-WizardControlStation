<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OcdWizard.ControlStation.ViewModels"
             xmlns:loc="using:OcdWizard.ControlStation.Localization"
             x:Class="OcdWizard.ControlStation.Views.LogPanelView"
             x:DataType="vm:ParticipantViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Log_SyncedLogsHeader}" FontWeight="SemiBold" Margin="6,4" />
        <ListBox ItemsSource="{Binding LogSync.RecentLogs}" MaxHeight="220"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="10" FontFamily="Consolas, Courier New"
                               Text="{Binding Kind, StringFormat='{}{0}'}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
