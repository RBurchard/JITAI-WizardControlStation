<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OcdWizard.ControlStation.ViewModels"
        xmlns:views="using:OcdWizard.ControlStation.Views"
        xmlns:ctrl="using:OcdWizard.ControlStation.Controls"
        xmlns:loc="using:OcdWizard.ControlStation.Localization"
        x:Class="OcdWizard.ControlStation.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:T Common_AppWindowTitle}"
        Icon="avares://OcdWizard.ControlStation/Assets/odi_icon.png"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="560">

    <!-- Panel layers the guided-tour overlay on top of the whole UI. -->
    <Panel>
    <DockPanel>

        <!-- ── Top bar ────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#12152A" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">

                <!-- Title + mode toggle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="🧪" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{loc:T Common_AppName}" FontSize="17" FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="{loc:T Common_AppSubtitle}" FontSize="10" Foreground="#6677AA" />
                    </StackPanel>
                    <ToggleButton IsChecked="{Binding IsReplayMode}"
                                  Margin="14,0,0,0" Padding="12,7" CornerRadius="6"
                                  Background="#252535" Foreground="#CCC"
                                  BorderThickness="1" BorderBrush="#3A3A55"
                                  ToolTip.Tip="{loc:T TopBar_ModeToggleTooltip}">
                        <Panel>
                            <TextBlock Text="{loc:T TopBar_ExperimentMode}" IsVisible="{Binding !IsReplayMode}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T TopBar_ReplayMode}" IsVisible="{Binding IsReplayMode}"
                                       VerticalAlignment="Center" />
                        </Panel>
                    </ToggleButton>
                </StackPanel>

                <!-- Session name -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="20,0"
                            IsVisible="{Binding !IsReplayMode}">
                    <TextBlock Text="{loc:T TopBar_SessionLabel}" Foreground="#7788AA"
                               VerticalAlignment="Center" FontSize="12" />
                    <TextBox Name="TutSessionName" Text="{Binding SessionName}" Width="200"
                             Watermark="{loc:T TopBar_SessionNameWatermark}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Single/Dual watch toggle -->
                <ToggleButton Grid.Column="2" Name="TutWatchToggle"
                              IsChecked="{Binding DualParticipantMode}"
                              IsVisible="{Binding !IsReplayMode}"
                              Margin="0,0,6,0"
                              Padding="12,7"
                              CornerRadius="6"
                              Background="#252535"
                              Foreground="#CCC"
                              BorderThickness="1"
                              BorderBrush="#3A3A55"
                              ToolTip.Tip="{loc:T TopBar_WatchCountToggleTooltip}">
                    <Panel>
                        <TextBlock Text="{loc:T TopBar_OneWatch}"
                                   IsVisible="{Binding !DualParticipantMode}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T TopBar_TwoWatches}"
                                   IsVisible="{Binding DualParticipantMode}"
                                   VerticalAlignment="Center" />
                    </Panel>
                </ToggleButton>

                <!-- Start session -->
                <Button Grid.Column="3" Name="TutStartSession" Classes="Primary"
                        Content="{loc:T TopBar_StartSession}"
                        Command="{Binding StartSessionCommand}"
                        IsVisible="{Binding !IsReplayMode}"
                        IsEnabled="{Binding SessionActive, Converter={x:Static BoolConverters.Not}}"
                        Margin="0,0,6,0" />

                <!-- Stop session -->
                <Button Grid.Column="4" Name="TutStopSession" Classes="Danger"
                        Content="{loc:T TopBar_StopSession}"
                        Command="{Binding StopSessionCommand}"
                        IsVisible="{Binding !IsReplayMode}"
                        IsEnabled="{Binding SessionActive}"
                        Margin="0,0,6,0" />

                <!-- Export / Trivia / Tutorial -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Button Name="TutExport" Classes="Subtle"
                            Content="{loc:T TopBar_ExportCsv}"
                            IsVisible="{Binding !IsReplayMode}"
                            Click="OnExportClick" />
                    <Button Name="TutTrivia" Classes="Subtle"
                            Content="{loc:T TopBar_Trivia}"
                            IsVisible="{Binding !IsReplayMode}"
                            Click="OnManageTriviaClick" />
                    <Button Name="TutTutorialBtn" Classes="Subtle"
                            Content="{loc:T TopBar_Tutorial}"
                            ToolTip.Tip="{loc:T TopBar_TutorialTooltip}"
                            Click="OnTutorialClick" />
                    <Button Classes="Subtle"
                            Content="{loc:T Settings_ToolbarButton}"
                            ToolTip.Tip="{loc:T Settings_Tooltip}"
                            Click="OnSettingsClick" />
                </StackPanel>

                <!-- Status -->
                <Border Grid.Column="6" Background="#1A1D30" CornerRadius="5"
                        Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#7799CC" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <!-- ── Session notes ──────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#0E1124" Padding="16,8"
                BorderBrush="#1E2238" BorderThickness="0,0,0,1"
                IsVisible="{Binding !IsReplayMode}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:T Notes_Label}" Foreground="#7788AA"
                           VerticalAlignment="Top" FontSize="12" Margin="0,6,10,0" />
                <TextBox Grid.Column="1" Text="{Binding SessionNotes}"
                         Watermark="{loc:T Notes_Watermark}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="32" MaxHeight="90"
                         IsEnabled="{Binding SessionActive}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Grid.Column="2" Classes="Subtle" Content="{loc:T Notes_SaveButton}"
                        Command="{Binding SaveSessionNotesCommand}"
                        IsEnabled="{Binding SessionActive}"
                        VerticalAlignment="Top" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- ── Main content ───────────────────────────────────────────── -->
        <Grid Margin="6">
          <!-- Experiment Mode (live) -->
          <Grid IsVisible="{Binding !IsReplayMode}">
            <!-- Single-participant layout (full width) -->
            <ContentControl IsVisible="{Binding !DualParticipantMode}"
                            Content="{Binding Participant1}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:ParticipantViewModel">
                        <views:ParticipantPanel DataContext="{Binding}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Dual-participant layout -->
            <Grid IsVisible="{Binding DualParticipantMode}"
                  ColumnDefinitions="*,6,*">
                <ContentControl Grid.Column="0" Content="{Binding Participant1}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="vm:ParticipantViewModel">
                            <views:ParticipantPanel DataContext="{Binding}" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <GridSplitter Grid.Column="1" Background="#2A2D45"
                              ResizeDirection="Columns" />
                <ContentControl Grid.Column="2" Content="{Binding Participant2}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="vm:ParticipantViewModel">
                            <views:ParticipantPanel DataContext="{Binding}" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
          </Grid>

          <!-- Replay Mode (CSV playback) -->
          <Panel IsVisible="{Binding IsReplayMode}">
            <views:ReplayView DataContext="{Binding Replay}" />
          </Panel>
        </Grid>

    </DockPanel>

        <!-- Guided tour overlay (hidden until first launch or the Tutorial button). -->
        <ctrl:TutorialOverlay Name="Tutorial" />

        <!-- "Starting session…" blocking overlay shown while devices are being readied. -->
        <Border IsVisible="{Binding IsStartingSession}"
                Background="#80000000">
            <Border Background="#1E2040" CornerRadius="12" Padding="40,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #60000000">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:T Startup_StartingSessionTitle}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T Startup_StartingSessionBody}"
                               FontSize="13" Foreground="#99AABB"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
