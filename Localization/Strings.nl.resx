  <data name="Tutorial_Connection_Body" xml:space="preserve">
    <value>Typ het IP-adres van de telefoon in, of druk op Scannen om apparaten automatisch te vinden. Kies er één uit de lijst en druk op Verbinden om de livedata te ontvangen.</value>
  </data>
